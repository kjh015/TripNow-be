# k6 실행 환경 변수. 복사해서 .env로 쓴다 (.env는 커밋되지 않는다).
# docker run --env-file load-test/.env 로 넘긴다. 값에 따옴표를 쓰지 않는다.

# 게이트웨이 주소. k6가 컨테이너 안에서 돌기 때문에 localhost 대신 host.docker.internal
BASE_URL=http://host.docker.internal:8000

# 시드 계정 비밀번호: 8~20자, 영문·숫자·특수문자(@$!%*#?&) 포함
SEED_PASSWORD=

# -o experimental-prometheus-rw 를 붙였을 때 결과를 보낼 곳 (Prometheus)
K6_PROMETHEUS_RW_SERVER_URL=http://host.docker.internal:9091/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS=p(50),p(95),p(99),avg,max
